# Copia este archivo a .env y ajusta los valores.

# --- Entorno ---
# FLASK_ENV=development          # development | production | testing
# FLASK_CONFIG=development       # override explícito (development | production | testing)

# Obligatorio en producción (mínimo 32 caracteres aleatorios)
SECRET_KEY=cambia-esto-en-produccion-con-32-caracteres-o-mas
# Si se define, el panel de plataforma exige una clave de mínimo 32 caracteres y TOTP.
PLATFORM_ADMIN_KEY=tu-clave-superadmin-plataforma-de-32-caracteres
# Generar secreto: python -c "import pyotp; print(pyotp.random_base32())"
# PLATFORM_ADMIN_TOTP_SECRET=
# PLATFORM_MFA_REQUIRED=true
# PLATFORM_SESSION_IDLE_MINUTES=15
# PLATFORM_SESSION_ABSOLUTE_MINUTES=120
# PLATFORM_MFA_PENDING_MINUTES=5
# JWT_EXPIRES_MINUTES=480
# Hosts separados por coma; Render añade automáticamente su hostname onrender.com.
# TRUSTED_HOSTS=app.roustix.com,www.app.roustix.com

# Solo desarrollo: usuario admin inicial (requiere DEFAULT_ADMIN_PASSWORD explícita)
# DEFAULT_ADMIN_PASSWORD=tu-clave-dev-segura

# --- Base de datos ---
# SQLite local (desarrollo):
# DATABASE_URL=sqlite:///mantenimiento.db
#
# Neon PostgreSQL (producción):
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Solo CI/testing: permite ejecutar la suite completa contra una base aislada.
# TEST_DATABASE_URL=postgresql://roustix_ci:clave@127.0.0.1:5432/roustix_ci
#

# --- Logging ---
# LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
# LOG_JSON=true                  # JSON estructurado (auto en producción)

# --- Arranque ---
# RUN_STARTUP_TASKS=true         # Seeds y mantenimiento al arrancar (auto en dev)
# RUN_LEGACY_SCHEMA_MIGRATIONS=false  # ensure_* legacy (solo transición)

# --- Backups Neon ---
# BACKUP_DIR=backups
# BACKUP_RETENTION_DAYS=7
# NEON_PROJECT_ID=               # opcional, para API de Neon
# NEON_API_KEY=                  # opcional, para snapshots vía API

# --- Almacenamiento persistente de archivos (S3 / Cloudflare R2 / Backblaze B2) ---
# En producción debe ser s3. El modo local solo se recomienda para desarrollo/pruebas.
# STORAGE_BACKEND=s3
# STORAGE_BUCKET=roustix-production
# STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# Bucket de recuperación distinto al operativo. Se recomienda versionado/Object Lock.
# STORAGE_BACKUP_BUCKET=roustix-production-recovery
# STORAGE_BACKUP_PREFIX=roustix
# STORAGE_BACKUP_ENDPOINT_URL=https://<backup-account-id>.r2.cloudflarestorage.com
# STORAGE_BACKUP_REGION=auto
# STORAGE_BACKUP_ACCESS_KEY_ID=
# STORAGE_BACKUP_SECRET_ACCESS_KEY=
# Desarrollo local opcional:
# STORAGE_LOCAL_ROOT=data/object_storage

# --- Correo transaccional (temporal: Gmail SMTP) ---
# Activa la verificación en dos pasos en Gmail y crea una contraseña de aplicación.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=cuenta.temporal@gmail.com
MAIL_PASSWORD=contraseña-de-aplicacion-de-16-caracteres
MAIL_DEFAULT_SENDER=Roustix <cuenta.temporal@gmail.com>
# MAIL_TIMEOUT_SECONDS=10

# Seguridad de verificación de correo
# EMAIL_VERIFICATION_TTL_MINUTES=10
# EMAIL_VERIFICATION_MAX_ATTEMPTS=5
# EMAIL_VERIFICATION_RESEND_SECONDS=60
# PASSWORD_RESET_TTL_MINUTES=60
